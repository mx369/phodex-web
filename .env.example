# Public relay
PHODEX_HOST=0.0.0.0
PHODEX_PORT=3443
PHODEX_RELAY_LABEL=Phodex Public Relay
PHODEX_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email OTP delivery
# Prefer PHODEX_* names. The relay also accepts RESEND_API_KEY and AUTH_EMAIL_FROM.
PHODEX_RESEND_API_KEY=
PHODEX_AUTH_EMAIL_FROM=

# Optional relay persistence
PHODEX_STATE_FILE=apps/server/data/relay-state.json
PHODEX_THREAD_HISTORY_PAGE_SIZE=200

# Local bridge
PHODEX_RELAY_URL=ws://127.0.0.1:3443
PHODEX_BRIDGE_TOKEN=
PHODEX_DEVICE_LABEL=
PHODEX_CODEX_WS_URL=ws://127.0.0.1:8765
PHODEX_MANAGE_CODEX=false
PHODEX_DEFAULT_CWD=
PHODEX_PROJECTS_ROOT=
PHODEX_WORKTREE_ROOT=

# Diagnostics
PHODEX_FLOW_TRACE=false
